  ---
  import ModalBooths from "@/components/ModalBooths.astro";
  import ModalVideo from "@/components/ModalVideo.astro";
  import BoothLayout from "@/layouts/BoothLayout.astro";
  const booth = {
  image: "bg-MAHDA.webp",
  logo: "logo-mahda.webp",
  btn1: "newsletter.svg",
  btn2: "contacto.svg",
  };
  ---

  <BoothLayout
    title="Massachusetts Hispanic Dental Association"
    description="La Asociación Dental Hispana de Massachusetts (MHDA, por sus siglas en inglés) es el principal colectivo profesional, centro de formación continua y defensor de la salud pública para los profesionales de la odontología, estudiantes de odontología y equipos auxiliares de origen hispano en todo el estado."
  >
    <section class="section banner-booth alzheimer-assoc">
      <div class="is-overlay"></div>
      <div class="container has-text-white">
        <div class="columns is-centered">
          <div class="column is-6 has-text-centered">
            <svg
              version="1.1"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              viewBox="0 0 600 750"
            >
              <image
                width="600"
                height="780"
                xlink:href={"/img/booths-bg/" + booth.image}
              />

              <!-- Video -->
              <a
                href="javascript:void(0)"
                class="modal-trigger video"
                data-target="modal-video"
              >
                <image x="280" y="145" href="/img/booths-pics/youtube.svg" width="100" />
              </a>

              <!-- Logo -->
              <image x="190" y="450" xlink:href={"/img/booths-pics/" + booth.logo} width="220" />

              <!-- Newsletter -->
              <a
                href="/docs-booths/newsletter-mahda.pdf"
                target="_blank"
                class="newsletter"
              >
                <image x="100" y="530" xlink:href={"/img/booths-pics/" + booth.btn1} width="200" />
              </a>



              <!-- Contacto -->
              <a
                href="mailto:massachusettshda@gmail.com"
                class="contacto"
              >
                <image
                  x="305"
                  y="530"
                  xlink:href={"/img/booths-pics/" + booth.btn2}
                  width="200"
                />
              </a>
            </svg>
          </div>
        </div>
      </div>

      <div class="has-text-centered mt-5">
        <a href="/" class="button is-light is-rounded is-outlined is-large"
          >Volver a la Feria</a
        >
      </div>
    </section>

    <ModalBooths />

    <ModalVideo videoID="TC69J7zYLCk" />

  </BoothLayout>
