---
import ModalBooths from "@/components/ModalBooths.astro";
import ModalFormEC from "@/components/ModalFormEC.astro";
import ModalVideo from "@/components/ModalVideo.astro";
import BoothLayout from "@/layouts/BoothLayout.astro";
const booth = {
image: "bg-element-care.webp",
  logo: "element-care-logo.webp",
  btn1: "brochure.svg",
  btn2: "contacto.svg",
};

---

<BoothLayout
   title="Dana Farber Cancer Institute"
   description="Lorem ipsum dolor sit amet"
>
   <section class="section banner-booth dana-farber">
      <div class="is-overlay"></div>
      <div class="container has-text-white">
         <div class="columns is-centered">
            <div class="column is-6 has-text-centered">
               <svg
                  version="1.1"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                  viewBox="0 0 600 780"
               >
                  <image
                     width="600"
                     height="780"
                     xlink:href={"/img/booths-bg/" + booth.image}
                  />

                  <a
                     href="javascript:void(0)"
                     class="modal-trigger video"
                     data-target="modal-video"
                  >
                     <image x="280" y="145" href="/img/booths-pics/youtube.svg" width="100" />
                  </a>

                  <!-- Logo -->
                  <image
                     x="190"
                     y="450"
                     xlink:href={"/img/booths-pics/" + booth.logo}
                     width="240"
                  />

                  <!-- Brochure -->
                  <a
                     href="/docs-booths/Eligibility-EC-SPA.pdf"                     
                     class="brochure"
                     target="_blank"
                  >
                     <image
                        x="95"
                        y="555"
                        width="200"
                        xlink:href={"/img/booths-pics/" + booth.btn1}
                     />
                  </a>

                 Contacto
                  <a
                     href="javascript:void(0)"
                     class="modal-trigger contacto is-hidden-mobile"
                     data-target="modal-form"
                  >
                     <image
                        x="300"
                        y="555"
                        width="200"
                        xlink:href={"/img/booths-pics/" + booth.btn2}
                     />
                  </a>

                 <!-- Contacto mobile-->
                 <a 
                   href="mailto:crosario@elementcare.org" 
                   class="is-hidden-desktop contacto" 
                   target="_blank"
                 >
                   <image x="310" y="550" :href="'/img/booths-pics/' + booth.btn2" width="200" />
                 </a>
               </svg>
            </div>
         </div>
      </div>

      <div class="has-text-centered mt-5">
         <a href="/" class="button is-light is-rounded is-outlined is-medium"
            >Volver a la Feria</a
         >
      </div>
   </section>

   <ModalBooths />

   <ModalVideo videoID="ryyOrFnczPo" />

   <ModalFormEC
      to="crosario@elementcare.org"
      subject="Nuevo contacto web - Element Care"
      logoHeader={booth.logo}
   />
</BoothLayout>
